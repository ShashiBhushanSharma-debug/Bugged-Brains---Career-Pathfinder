# ==============================================================================
# Career Pathfinder — Backend Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL connection
# Found in: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "URI" format (Session mode, port 5432).
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.olaxjoqrbuwehlopbpzq.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# App settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Development: default learner ID used when no auth token is present
# This will be replaced by the real auth.uid() in Phase 3.
# ------------------------------------------------------------------------------
DEV_LEARNER_ID=u_1001

# ------------------------------------------------------------------------------
# Groq API key (used by Member 1's AI engine — NOT by this backend module)
# Included here so a single .env works for the full project.
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=csk-c4jpnvf8k8rcw6r54xf855pt3k8cm2tv8wh4c8t2r2e88f6h
