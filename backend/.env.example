# ==============================================================================
# Career Pathfinder — Backend Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL connection
# Found in: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "URI" format (Session mode, port 5432).
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Supabase Auth — JWT verification
# Found in: Supabase Dashboard > Project Settings > API > JWT Secret
# The backend uses this to verify Supabase access tokens (HS256).
# IMPORTANT: This is the base64-encoded secret from the Supabase dashboard.
# The backend automatically base64-decodes it before verification.
# ------------------------------------------------------------------------------
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ------------------------------------------------------------------------------
# App settings
# IMPORTANT: Set APP_ENV=production on Render. Do NOT use "development" in prod.
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# IMPORTANT: Add your Vercel production URL here for production deployments.
# Example for production on Render:
#   CORS_ORIGINS=https://careerpathfinder-gamma.vercel.app,http://localhost:5173
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Development: default learner ID used when no auth token is present
# Only used when APP_ENV=development. Never used in production.
# ------------------------------------------------------------------------------
DEV_LEARNER_ID=u_1001

# ------------------------------------------------------------------------------
# Cerebras API key (used by Member 1's AI engine — NOT by this backend module)
# Included here so a single .env works for the full project.
# Get your key from: https://cloud.cerebras.ai/
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=your-cerebras-api-key-here
